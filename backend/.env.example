# HeliXpert Backend Environment Configuration

# OpenAI API Key (Kept strictly on the backend)
OPENAI_API_KEY=your-openai-api-key-here

# Google Gemini API Key (for Vision and Fast Analytics)
GEMINI_API_KEY=your-gemini-api-key-here
GOOGLE_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-3.5-flash

# Database URL:
# For local SQLite zero-setup:
DATABASE_URL=sqlite:///./data/helixpert.db
# For PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/helixpert

# Application Security
SECRET_KEY=helixpert-aerospace-super-secret-key-2026
FRONTEND_URL=http://localhost:3000

# Limits
MAX_UPLOAD_SIZE_MB=50
MAX_QUERY_ROWS=1000

